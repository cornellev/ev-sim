# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.playwright-data

# next.js
/.next/
/.next-playwright/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# server-side persisted editor data (environments, scripts, bindings)
/server/data

# large files
public/scenarios
public/scenario-docs

baking/raw
baking/__pycache__
baking/venv
baking/baked

tests/__pycache__

# Python headless adapter
/python/.venv
/python/.pytest_cache
/python/.ruff_cache
/python/build
/python/dist
/python/src/*.egg-info
/python/**/__pycache__

.cursor

graphify-out

# local experiment / controller scaffolding (non-upstream)
.experiments
