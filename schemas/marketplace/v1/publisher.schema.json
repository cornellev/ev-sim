{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cev-sim.dev/schemas/marketplace/v1/publisher.schema.json",
  "type": "object",
  "required": ["kind", "version", "publisherId", "namespaces", "keys"],
  "properties": {
    "kind": { "const": "cev-sim.marketplace-publisher" },
    "version": { "const": 1 },
    "publisherId": { "$ref": "common.schema.json#/$defs/marketplaceId" },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/marketplaceId" }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keyId", "algorithm", "publicKey", "status", "createdAt", "statusChangedAt"],
        "properties": {
          "keyId": { "$ref": "common.schema.json#/$defs/sha256" },
          "algorithm": { "const": "ed25519" },
          "publicKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "status": { "enum": ["active", "retired", "revoked"] },
          "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "statusChangedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
