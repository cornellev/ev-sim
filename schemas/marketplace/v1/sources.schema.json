{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cev-sim.dev/schemas/marketplace/v1/sources.schema.json",
  "type": "object",
  "required": ["kind", "version", "revision", "sources"],
  "properties": {
    "kind": { "const": "cev-sim.marketplace-sources" },
    "version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "registryId", "name", "baseUrl", "trustedRootFingerprint", "enabled", "priority", "credentialRef"],
        "properties": {
          "sourceId": { "$ref": "common.schema.json#/$defs/uuid" },
          "registryId": { "$ref": "common.schema.json#/$defs/uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "baseUrl": { "type": "string", "format": "source-url" },
          "trustedRootFingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "credentialRef": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 255 },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
