{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cev-sim.dev/schemas/marketplace/v1/installed.schema.json",
  "type": "object",
  "required": ["kind", "version", "revision", "installations"],
  "properties": {
    "kind": { "const": "cev-sim.marketplace-installed" },
    "version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "installations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "registryId", "release", "receiptHashes", "status"],
        "properties": {
          "sourceId": { "$ref": "common.schema.json#/$defs/uuid" },
          "registryId": { "$ref": "common.schema.json#/$defs/uuid" },
          "release": { "$ref": "common.schema.json#/$defs/exactReleaseRef" },
          "receiptHashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/sha256" } },
          "status": { "enum": ["installed", "yanked", "blocked"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
