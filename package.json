{
  "name": "cev-sim",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "cev-sim": "bin/cev-sim.js"
  },
  "scripts": {
    "dev": "node server/App.js",
    "build": "next build",
    "start": "node server/App.js",
    "lint": "eslint",
    "test": "node --experimental-default-type=module --test tests/*.test.js",
    "test:headless": "node --experimental-default-type=module --test tests/headless-*.test.js",
    "test:lidar": "node --experimental-default-type=module --test tests/lidar-*.test.js tests/headless-lidar.test.js",
    "test:gpu-sensors": "node --experimental-default-type=module --test tests/gpu-sensors.test.js",
    "test:shared-memory": "node --experimental-default-type=module --test tests/shared-memory.test.js",
    "test:supervisor": "node --experimental-default-type=module --test tests/headless-supervisor.test.js",
    "test:cli": "node --experimental-default-type=module --test tests/headless-runner.test.js tests/headless-cli.test.js",
    "test:parity": "node --experimental-default-type=module scripts/headless-parity.mjs",
    "test:soak": "node --experimental-default-type=module scripts/headless-soak.mjs",
    "test:soak:quick": "node --experimental-default-type=module scripts/headless-soak.mjs --quick",
    "benchmark:headless": "node --experimental-default-type=module scripts/headless-benchmark.mjs",
    "benchmark:headless:quick": "node --experimental-default-type=module scripts/headless-benchmark.mjs --quick",
    "dist:headless": "node --experimental-default-type=module scripts/build-headless-dist.mjs",
    "dist:verify": "node --experimental-default-type=module scripts/verify-headless-dist.mjs",
    "release:check": "node --experimental-default-type=module scripts/release-check.mjs",
    "host:validate": "node --experimental-default-type=module scripts/validate-headless-host.mjs",
    "artifacts:install": "node --experimental-default-type=module scripts/install-headless-artifacts.mjs",
    "test:python": "python3 -m pytest python/tests",
    "lint:python": "cd python && python3 -m ruff check src tests scripts",
    "proto:python": "python3 python/scripts/generate_proto.py --check",
    "fixtures:headless": "node --experimental-default-type=module scripts/generate-headless-fixtures.mjs",
    "test:ui": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.19.3",
    "@dimforge/rapier3d-compat": "0.19.3",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@jax-js/jax": "^0.1.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sparkjsdev/spark": "^0.1.10",
    "@tabler/icons-react": "^3.45.0",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-clouds": "^0.7.6",
    "@takram/three-geospatial": "^0.9.1",
    "@takram/three-geospatial-effects": "^0.6.4",
    "3d-tiles-renderer": "^0.4.28",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "next": "^16.1.6",
    "noisejs": "^2.1.0",
    "postprocessing": "^6.39.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rosnodejs": "^0.1.1",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.8",
    "uplot": "^1.6.32",
    "vmath": "^1.4.8",
    "ws": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4"
  },
  "optionalDependencies": {
    "playwright-core": "1.62.0"
  }
}
