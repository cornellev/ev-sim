{
  "kind": "cev-sim.protobuf-interface",
  "version": 2,
  "schemas": [
    {
      "id": "onboarding",
      "fingerprint": "c1af914ec3f659a0c31e88efdb55d39cef9081f2db463f45a30146e8f35e0f95",
      "descriptorBase64": ""
    }
  ],
  "routes": [
    {
      "id": "command",
      "schemaId": "onboarding",
      "messageType": "cev.onboarding.v1.CommandUpdate",
      "direction": "subscribe",
      "key": "cev/onboarding/v1/{run_id}/command",
      "target": {
        "topicId": "controls-command"
      },
      "mapping": {
        "fields": [
          {
            "to": "runId",
            "from": "value.header.run_id"
          },
          {
            "to": "leaseId",
            "from": "value.control_lease_id"
          },
          {
            "to": "sequence",
            "from": "value.header.sequence"
          },
          {
            "to": "captureTimeNs",
            "from": "value.header.time_ns"
          },
          {
            "to": "deadlineNs",
            "from": "value.valid_until_ns"
          },
          {
            "to": "speedMps",
            "from": "value.command.speed_mps"
          },
          {
            "to": "steeringRad",
            "from": "value.command.steering_rad"
          },
          {
            "to": "mode",
            "value": "velocity"
          },
          {
            "to": "frameId",
            "value": "base_link"
          },
          {
            "to": "accelerationMps2",
            "value": 0
          },
          {
            "to": "jerkMps3",
            "value": 0
          },
          {
            "to": "steeringRateRadps",
            "value": 0
          }
        ],
        "metadata": [
          {
            "to": "runId",
            "from": "value.header.run_id"
          },
          {
            "to": "frameId",
            "from": "value.header.frame_id"
          },
          {
            "to": "sequenceId",
            "from": "value.header.sequence"
          },
          {
            "to": "captureTimeNs",
            "from": "value.header.time_ns"
          }
        ],
        "checks": [
          {
            "from": "value.header.run_id",
            "equalsFrom": "run.runId"
          },
          {
            "from": "value.header.frame_id",
            "value": "base_link"
          }
        ]
      }
    },
    {
      "id": "lidar",
      "schemaId": "onboarding",
      "messageType": "cev.onboarding.v1.LidarUpdate",
      "direction": "publish",
      "key": "cev/onboarding/v1/{run_id}/lidar",
      "source": {
        "topicId": "front-lidar-points"
      },
      "mapping": {
        "fields": [
          {
            "to": "header.run_id",
            "from": "run.runId"
          },
          {
            "to": "header.sequence",
            "from": "metadata.sequenceId",
            "offset": 1
          },
          {
            "to": "header.time_ns",
            "from": "metadata.captureTimeNs"
          },
          {
            "to": "header.frame_id",
            "value": "front_lidar_frame"
          },
          {
            "to": "scan.points",
            "each": {
              "from": "value.points",
              "fields": [
                {
                  "to": "x",
                  "from": "item.x"
                },
                {
                  "to": "y",
                  "from": "item.y"
                }
              ]
            }
          },
          {
            "to": "scan.sensor_in_vehicle.position.x",
            "from": "bindings.sensor.poseInRearAxle.position.x"
          },
          {
            "to": "scan.sensor_in_vehicle.position.y",
            "from": "bindings.sensor.poseInRearAxle.position.y"
          },
          {
            "to": "scan.sensor_in_vehicle.yaw_rad",
            "from": "bindings.sensor.poseInRearAxle.orientation",
            "operation": "quaternionYaw"
          }
        ],
        "bindings": {
          "vehicleId": "ego",
          "sensorId": "front-lidar",
          "rearWheelIds": [
            "rear-left",
            "rear-right"
          ]
        }
      }
    },
    {
      "id": "path",
      "schemaId": "onboarding",
      "messageType": "cev.onboarding.v1.PathUpdate",
      "direction": "subscribe",
      "key": "cev/onboarding/v1/{run_id}/path",
      "target": {
        "topicId": "planning-path"
      },
      "mapping": {
        "fields": [
          {
            "to": "points",
            "each": {
              "from": "value.path.points",
              "fields": [
                {
                  "to": "x",
                  "from": "item.x"
                },
                {
                  "to": "y",
                  "from": "item.y"
                },
                {
                  "to": "z",
                  "value": 0
                }
              ]
            }
          }
        ],
        "metadata": [
          {
            "to": "runId",
            "from": "value.header.run_id"
          },
          {
            "to": "frameId",
            "from": "value.header.frame_id"
          },
          {
            "to": "sequenceId",
            "from": "value.header.sequence"
          },
          {
            "to": "captureTimeNs",
            "from": "value.header.time_ns"
          }
        ],
        "checks": [
          {
            "from": "value.header.run_id",
            "equalsFrom": "run.runId"
          },
          {
            "from": "value.header.frame_id",
            "value": "map"
          }
        ]
      }
    },
    {
      "id": "state",
      "schemaId": "onboarding",
      "messageType": "cev.onboarding.v1.StateUpdate",
      "direction": "publish",
      "key": "cev/onboarding/v1/{run_id}/state",
      "source": {
        "topicId": "truth-odometry"
      },
      "mapping": {
        "fields": [
          {
            "to": "header.run_id",
            "from": "run.runId"
          },
          {
            "to": "header.sequence",
            "from": "metadata.sequenceId"
          },
          {
            "to": "header.time_ns",
            "from": "metadata.captureTimeNs"
          },
          {
            "to": "header.frame_id",
            "value": "map"
          },
          {
            "to": "state.pose.position.x",
            "from": "derived.rearPose.position.x"
          },
          {
            "to": "state.pose.position.y",
            "from": "derived.rearPose.position.y"
          },
          {
            "to": "state.pose.yaw_rad",
            "from": "derived.rearPose.orientation",
            "operation": "quaternionYaw"
          },
          {
            "to": "state.speed_mps",
            "from": "value.linearVelocity.x"
          }
        ],
        "bindings": {
          "vehicleId": "ego",
          "sensorId": "front-lidar",
          "rearWheelIds": [
            "rear-left",
            "rear-right"
          ]
        },
        "derived": [
          {
            "id": "rearPose",
            "from": "value.pose",
            "operation": "poseAtOffset",
            "offsetFrom": "bindings.vehicle.rearAxleInBase"
          }
        ]
      }
    }
  ],
  "bootstrap": []
}
